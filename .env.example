# CareerVerse AI Environment

# Required — NextAuth JWT/session signing (generate: openssl rand -base64 32)
AUTH_SECRET=

# Required — canonical site URL for auth callbacks (local or https://….vercel.app)
AUTH_URL="http://localhost:3000"

# Optional — enables NextAuth Google OAuth provider (Firebase Google on auth pages is primary)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Firebase (client) — from Firebase Console → Project settings → Your apps
# Project: careerverse-ai-3f969
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=careerverse-ai-3f969
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — Analytics only
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server) — required on Vercel for Firestore user upsert / onboarding / dashboard
# Create: Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=careerverse-ai-3f969
FIREBASE_CLIENT_EMAIL=
# Paste private_key from the JSON; keep \n escapes (or wrap in quotes with real newlines)
FIREBASE_PRIVATE_KEY=
# Optional — override Storage bucket (defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET)
FIREBASE_STORAGE_BUCKET=

# Optional — AI career analysis / chat / matching (falls back to heuristics without key)
AI_PROVIDER="openai"
AI_API_KEY=
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_MAX_TOKENS=1200

# Optional — resume uploads when Firebase Storage is unavailable (ephemeral on Vercel)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=5242880

ANALYTICS_PROVIDER="none"

NEXT_PUBLIC_APP_NAME="CareerVerse AI"
# Required in production — same https URL as AUTH_URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel (Project → Settings → Environment Variables) ---
# Required for auth + student path (Google → onboarding → dashboard):
#   AUTH_SECRET
#   AUTH_URL / NEXT_PUBLIC_APP_URL
#   NEXT_PUBLIC_FIREBASE_API_KEY, AUTH_DOMAIN, PROJECT_ID, STORAGE_BUCKET,
#     MESSAGING_SENDER_ID, APP_ID (+ optional MEASUREMENT_ID)
#   FIREBASE_ADMIN_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY
# Optional:
#   AUTH_GOOGLE_ID/SECRET, AI_API_KEY (+ AI_*), FIREBASE_STORAGE_BUCKET, STORAGE_*
# Also add your production domain under Firebase Auth → Authorized domains.
#
# DATABASE_URL / Prisma are no longer required — user data lives in Firestore.
