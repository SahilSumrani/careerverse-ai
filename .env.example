# CareerVerse AI Environment

# Required — NextAuth JWT/session signing (generate: openssl rand -base64 32)
AUTH_SECRET=

# Required — canonical site URL for auth callbacks (local or https://….vercel.app)
# Production (Vercel): MUST be the live origin — never leave as localhost
#   AUTH_URL=https://careerverse-ai-gold.vercel.app
# Optional alias Auth.js also reads:
#   NEXTAUTH_URL=https://careerverse-ai-gold.vercel.app
AUTH_URL="http://localhost:3000"

# Optional — enables NextAuth Google OAuth provider (Firebase Google on auth pages is primary)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Firebase (client) — from Firebase Console → Project settings → Your apps
# Project: careerverse-ai-3f969
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=careerverse-ai-3f969
# Storage bucket — copy EXACT name from Firebase Console → Storage (bucket must exist / be enabled):
#   Legacy: careerverse-ai-3f969.appspot.com
#   New (2024+): careerverse-ai-3f969.firebasestorage.app
# Wrong or never-provisioned bucket → NoSuchBucket on download. Do not invent the name.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=careerverse-ai-3f969.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — Analytics only
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server) — required on Vercel for Firestore user upsert / onboarding / dashboard
# Create: Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=careerverse-ai-3f969
FIREBASE_CLIENT_EMAIL=
# Paste private_key from the JSON; keep \n escapes (or wrap in quotes with real newlines)
FIREBASE_PRIVATE_KEY=
# Optional server override (same rules as NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET). Prefer setting both on Vercel.
# Example: FIREBASE_STORAGE_BUCKET=careerverse-ai-3f969.appspot.com
FIREBASE_STORAGE_BUCKET=

# Optional — AI career analysis / chat / matching (falls back to heuristics without key)
# Groq example (OpenAI-compatible):
#   AI_PROVIDER=groq
#   AI_API_KEY=gsk_...
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
AI_PROVIDER="groq"
AI_API_KEY=
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"
AI_MAX_TOKENS=1200
AI_CHAT_MAX_TOKENS=400
AI_RESUME_DAILY_CAP=10
AI_CAREER_DAILY_CAP=8
AI_ROADMAP_DAILY_CAP=12
# Copilot-only output cap (defaults to 400 if unset) — keeps student chat cheaper than analysis
# AI_CHAT_MAX_TOKENS=400

# --- Platform admin (Firestore) ---
# There is no hardcoded backdoor. Grant access by editing the user document:
#   Firebase Console → Firestore → users/{uid} → field `roles` (array) include "PLATFORM_ADMIN"
#   (alias "ADMIN" is also accepted and stored/read as PLATFORM_ADMIN)
# Then sign out/in (or wait for JWT refresh) and open /admin.
# Server APIs re-check roles from Firestore on every request; JWT alone is not trusted for mutations.

# Optional — resume uploads when Firebase Storage is unavailable (ephemeral on Vercel — uses /tmp)
# Prefer Firebase Storage: enable Storage in Console, set bucket env to the real bucket id,
# plus Admin credentials. /tmp fallback never gets Storage signed URLs (avoids NoSuchBucket).
STORAGE_PROVIDER="firebase"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=5242880

ANALYTICS_PROVIDER="none"

NEXT_PUBLIC_APP_NAME="CareerVerse AI"
# Required in production — same https URL as AUTH_URL (no trailing slash, never localhost on Vercel)
#   NEXT_PUBLIC_APP_URL=https://careerverse-ai-gold.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel (Project → Settings → Environment Variables) ---
# Required for auth + student path (Google → onboarding → dashboard):
#   AUTH_SECRET
#   AUTH_URL=https://careerverse-ai-gold.vercel.app
#   NEXTAUTH_URL=https://careerverse-ai-gold.vercel.app   (optional alias; set if AUTH_URL alone is ignored)
#   NEXT_PUBLIC_APP_URL=https://careerverse-ai-gold.vercel.app
#   NEXT_PUBLIC_FIREBASE_API_KEY, AUTH_DOMAIN, PROJECT_ID, STORAGE_BUCKET,
#     MESSAGING_SENDER_ID, APP_ID (+ optional MEASUREMENT_ID)
#   FIREBASE_ADMIN_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY
# Optional:
#   AUTH_GOOGLE_ID/SECRET, AI_API_KEY (+ AI_*), FIREBASE_STORAGE_BUCKET, STORAGE_*
# Also add your production domain under Firebase Auth → Authorized domains
#   (e.g. careerverse-ai-gold.vercel.app — and any custom domain).
# Wrong AUTH_URL / NEXT_PUBLIC_APP_URL (still localhost) → sign-out / callbacks land on localhost.
#
# DATABASE_URL / Prisma are no longer required — user data lives in Firestore.

# --- Reticle (local agent verification only — never set on Vercel production) ---
# Pairing token for the Reticle bridge (dev). Same value in both vars when using hand-wired connect().
# RETICLE_TOKEN=
# NEXT_PUBLIC_RETICLE_TOKEN=
# Optional bridge port override (default 4400). Must match MCP server RETICLE_PORT if set.
# RETICLE_PORT=4400
