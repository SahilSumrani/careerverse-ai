# CareerVerse AI Environment

# Local SQLite (dev). On Vercel use a hosted Postgres URL instead — SQLite files
# do not persist on serverless. Example Neon/Supabase:
# DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require"
# NOTE: prisma/schema.prisma currently uses provider = "sqlite". For Vercel Postgres
# you must switch provider to "postgresql" and migrate before pointing DATABASE_URL there.
DATABASE_URL="file:./dev.db"

# Required — NextAuth JWT/session signing (generate: openssl rand -base64 32)
AUTH_SECRET=

# Required — canonical site URL for auth callbacks (local or https://….vercel.app)
AUTH_URL="http://localhost:3000"

# Optional — enables NextAuth Google OAuth provider (also keep Firebase Google on auth pages)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Firebase (client) — from Firebase Console → Project settings → Your apps
# Required for Google sign-in on SoftQA-style auth pages
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — Analytics only
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional — AI career analysis / chat / matching (falls back to heuristics without key)
AI_PROVIDER="openai"
AI_API_KEY=
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_MAX_TOKENS=1200

# Optional — resume uploads (local disk; ephemeral on Vercel serverless)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=5242880

ANALYTICS_PROVIDER="none"

NEXT_PUBLIC_APP_NAME="CareerVerse AI"
# Required in production — same https URL as AUTH_URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel (Project → Settings → Environment Variables) ---
# Required for auth + app shell:
#   AUTH_SECRET, AUTH_URL, NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_FIREBASE_* (6–7 vars)
# Required for dashboard/API/onboarding (anything Prisma):
#   DATABASE_URL (hosted DB; SQLite file: will not persist on Vercel)
# Optional:
#   AUTH_GOOGLE_ID/SECRET, AI_API_KEY (+ AI_*), STORAGE_*, ANALYTICS_PROVIDER
# Also add your production domain under Firebase Auth → Authorized domains.
