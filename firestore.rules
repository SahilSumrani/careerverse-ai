rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All app data access goes through Next.js Admin SDK (bypasses rules).
    // Client SDK must not read user docs (passwordHash / resume text live there).
    match /users/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
